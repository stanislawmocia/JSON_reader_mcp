{
  "name": "mcp-json-reader-server",
  "version": "1.0.0",
  "description": "LLM-optimized MCP server for exploring large JSON files with minimal token usage",
  "type": "module",
  "bin": {
    "mcp-json-reader": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "prepare": "npm run build",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "json",
    "explorer",
    "llm",
    "cache"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "jsonpath-plus": "^10.2.0",
    "node-cache": "^5.1.2",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
